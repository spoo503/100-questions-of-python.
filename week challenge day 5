Q23. Library Management:
add book
remove book
show books
class Library:
    def __init__(self):
        self.books=[]

    def add(self,book):
        self.books.append(book)
        print("Book added")

    def remove(self,book):
        if book in self.books:
            self.books.remove(book)
            print("Book removed")
        else:
            print("Book not found")

    def show(self):
        if len(self.books)==0:
            print("Library is empty")
        else:
            print("Books in library:")
            for i in self.books:
                print(i)


l=Library()

while True:
