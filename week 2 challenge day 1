14.Person → Student
class Person:
    def __init__(self, name):
        self.name = name
    def display(self):
        print("Name:", self.name)

class Student(Person):  # ← was inheriting Animal!
    def __init__(self, name, roll):
        super().__init__(name)  # ← call parent constructor
        self.roll = roll
    def display(self):
        super().display()
        print("Roll:", self.roll)

s = Student("Alice", 101)
s.display()


