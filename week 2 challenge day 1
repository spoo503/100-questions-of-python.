        self.name = name
        self.roll = roll
        print("Object created for", self.name)
    def display(self):
        print("Name:", self.name, "| Roll:", self.roll)
    def __del__(self):  # destructor
        print("Object deleted for", self.name)

s = Student("Alice", 101)
s.display()
del s  # triggers __del__


