16.Multiple inheritance
class Father:
    def strong(self):
        print("Strong")

class Mother:
    def caring(self):
        print("Caring")

class Child(Father, Mother):   # inherits from BOTH
    def study(self):
        print("Studying")

c = Child()
c.strong()    # from Father
c.caring()   # from Mother
c.study()    # own method
17.Multilevel inheritance
class Animal:
    def eat(self):
        print("Eating")

class Dog(Animal):          # Dog inherits from Animal
    def bark(self):
        print("Bark")

class Puppy(Dog):           # Puppy inherits from Dog (and Animal too!)
    def play(self):
        print("Playing")

p = Puppy()
p.eat()    # works — came from Animal
p.bark()   # works — came from Dog
p.play()   # works — own method


