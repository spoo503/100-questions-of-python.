5.Create class Rectangle → area method
class Rectangle:
    def __init__(self,l,b):
        self.l=l
        self.b=b
    def Area(self):
        area=self.l*self.b
        print("Area of the rectangle",area)
l=int(input("Enter the length"))
b=int(input("Enter the breadth"))
r=Rectangle(l,b)
r.Area()

6.Create class Circle → circumference method
class Circle:
    def __init__(self,r):
        self.r=r
    def Area(self):
        area=2*3.14*self.r
        print("Area of the circle",area)
r=int(input("Enter the Radius"))
a=Circle(r)
a.Area()

