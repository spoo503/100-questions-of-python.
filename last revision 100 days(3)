Count occurrences of a character in a string; 
a=input("Enter the string")
count=0
alpha=0
n=0
for i in range(len(a)):
    if a[i].isalpha():
        alpha+=1
        print("ALPHABET")
    elif a[i].isnumeric():
        print("NUMERIC")
        n+=1
    else:
        count+=1
print(alpha)
print(n)
print(count)

