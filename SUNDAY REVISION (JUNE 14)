Create a calculator that:
Takes two inputs
Handles division by zero
Handles invalid input
Uses try, except, else, finally
The exception handling should be around the code that may cause an error, not around the function definitions.
class Calculator:
Approach 1: Call methods inside simple_calculator()
    def simple_calculator(self):
        try:
            self.a = int(input("Enter the value of a: "))
            self.b = int(input("Enter the value of b: "))

            self.add()
            self.sub()
            self.product()
            self.div()

        except ValueError:
            print("Invalid Input")

        except ZeroDivisionError:
            print("You cannot divide by zero")

        else:
            print("Calculation Successful")

        finally:
            print("THANK YOU")

    def add(self):
        print("SUM OF TWO NUMBERS", self.a + self.b)

    def sub(self):
        print("DIFF of a and b is", self.a - self.b)

    def product(self):
        print("Product of a and b", self.a * self.b)

    def div(self):
        print("Division of a and b is", self.a / self.b)

c = Calculator()
c.simple_calculator()

b.Approach 2: Call methods outside the class
class Calculator:

    def simple_calculator(self):
        try:
            self.a = int(input("Enter the value of a: "))
            self.b = int(input("Enter the value of b: "))

        except ValueError:
            print("Invalid Input")
            return False

        return True

    def add(self):
        print("SUM OF TWO NUMBERS", self.a + self.b)

    def sub(self):
        print("DIFF of a and b is", self.a - self.b)

    def product(self):
        print("Product of a and b", self.a * self.b)

    def div(self):
        try:
            print("Division of a and b is", self.a / self.b)

        except ZeroDivisionError:
            print("You cannot divide by zero")

        else:
            print("Calculation Successful")

        finally:
            print("THANK YOU")


c = Calculator()

if c.simple_calculator():
    c.add()
    c.sub()
    c.product()
    c.div()
