Write a function that detects if a string represents a valid float (without try/except);
class Solution:
    def __init__(self):
        pass
    def string(self):
        a=input("ENter the string")
        dot_count=a.count(".")
        without_dot=a.replace(".","")
        if dot_count==1 and without_dot.isdigit():
            print("Float")
        elif  dot_count>1 and without_dot.isdigit():
            print("int")
        elif dot_count==0 and without_dot.isalpha:
            print("ALPHABET")
s=Solution()
print(s.string())

