Easy:
Swap two variables without a third variable;
class swap:
    def __init__(self):
        pass
    def swap(self):
        a=int(input("Enter the number "))
        b=int(input("Enter the value of b"))
        a=a+b
        b=a-b
        a=a-b
        print("The value of a",a)
        print("The value of b is",b)
s=swap()
print(s.swap())

