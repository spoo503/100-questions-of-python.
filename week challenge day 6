23.ATM OOP system
class ATM:
    def __init__(self,balance):
        self.balance=balance

    def deposit(self,amount):
        self.balance+=amount
        print("Balance =",self.balance)

    def withdraw(self,amount):
        if amount>self.balance:
            raise ValueError("Insufficient balance")

        self.balance-=amount
        print("Balance =",self.balance)

    def show(self):
        print("Balance =",self.balance)


a=ATM(1000)

while True:
    try:
        print("1.DEPOSIT")
        print("2.WITHDRAW")
        print("3.SHOW")
        print("4.EXIT")

        ch=int(input())

        if ch==1:
            amount=int(input("Enter amount: "))
            a.deposit(amount)

        elif ch==2:
            amount=int(input("Enter amount: "))
            a.withdraw(amount)

        elif ch==3:
            a.show()

        elif ch==4:
            break

        else:
            print("Invalid choice")

    except ValueError as e:
        print(e)
