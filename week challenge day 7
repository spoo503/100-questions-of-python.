Part C — Recursion (19–22)


19.Factorial using recursion.
def factorial(n):
    if n == 0 or n == 1:   # base case — stop here
        return 1
    return n * factorial(n - 1)  # calls itself

print(factorial(5))  # 120


20.Sum of numbers from 1 to n using recursion
def sum_n(n):
    if n == 0:           # base case — stop here
        return 0
    return n + sum_n(n - 1)  # calls itself

print(sum_n(5))  # 15

21.Fibonacci using recursion
def fibonacci(n):
    if n == 0:                         # base case 1
        return 0
    if n == 1:                         # base case 2
        return 1
    return fibonacci(n-1) + fibonacci(n-2)  # calls itself twice

print(fibonacci(6))  # 8


22.Reverse string using recursion
def reverse_string(s):
    if len(s) == 0:       # base case — empty string, stop
        return ""
    return s[-1] + reverse_string(s[:-1])  # last char + reverse the rest

print(reverse_string("hello"))  # olleh


