Group a list of dictionaries by a key (e.g., group students by grade); 
class Solution:
    def __init__(self,name,sub,marks,grade):
        self.name=name
        self.sub=sub
        self.marks=marks
        self.grade=grade
    def group_of_class(self):
        n=int(input("ENter the number of students"))
        all_students=[]
        for i in range(n):
            name=input("ENter the name of the student")
            sub=input("Enter the subject")
            marks=int(input("Enter the marks of the sub"))
            grade=input("Enter the grade of the sub")
            students={"NAME":name,"SUB":sub,"MARKS":marks             ,"GRADE":grade}
            all_students.append(students)   # add to the list instead of overwriting

        # Now group all collected students by grade
        grouped = {}
        for students in all_students:
            g = students["GRADE"]
            if g not in grouped:
                grouped[g] = []
            grouped[g].append(students)

        return grouped

s = Solution("", "", 0, "")
result = s.group_of_class()
print(result)

class Solution: doesn't inherit from anything (it's not class Solution(SomeOtherClass):). 
There's no parent class above it, so there's nothing for super() to call — using it would either throw an error or be meaningless.

