Remove duplicates from a list; 
l = [1, 2, 3, 1, 2]
i = 0
while i < len(l):
    j = i + 1
    while j < len(l):
        if l[i] == l[j]:
            l.remove(l[j])
        else:
            j += 1
    i += 1
print(l)

