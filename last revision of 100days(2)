Check if a number is an Armstrong number;
num = input("Enter the number")
total = 0
power = len(num)
for char in num:
    digit = int(char)
    total += digit ** power
print(total)
if total == int(num):
    print("Armstrong number")
else:
    print("Not Armstrong")


