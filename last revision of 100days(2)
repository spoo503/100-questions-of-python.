Check if a number is an Armstrong number;
num = input("Enter the number")
total = 0
power = len(num)
for char in num:
    digit = int(char)
    total += digit ** power
print(total)
if total == int(num):
    print("Armstrong number")
else:
    print("Not Armstrong")


Find factorial using a loop (not recursion)
num=int(input("Enter the number"))
if num ==0 or num==1:
        print("Factorial is one")
elif num<0:
    print("Factorial cannot be calculated")
else:
    fact=1
    for i in range(2,num+1):
         fact=fact*i
    print("Factorail of the number is",fact)


