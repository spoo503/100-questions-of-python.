Find all prime numbers up to N using nested loops (Sieve logic without libraries);
n = int(input("Enter N: "))

for i in range(2, n+1):          # candidate numbers
    is_prime = True
    for j in range(2, i):         # check divisors smaller than i
        if i % j == 0:
            is_prime = False
            break
    if is_prime:
        print(i, "is prime")

