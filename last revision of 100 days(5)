Handle multiple exceptions (ValueError, ZeroDivisionError) in one function.
class Solution:
    def check_num(self):
        try:
            n=int(input("Enter the value"))
            b=int(input("Enter the value"))
            print(n%b)
        except ZeroDivisionError:
            print("Cannot be calculated by zero")
        except ValueError:
            print("Enter the valid value")
        finally:
            print("Thank you")
s=Solution()
print(s.check_num())
            

