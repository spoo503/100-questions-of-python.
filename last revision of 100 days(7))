Find all keys that have a specific value;
#Find all keys that have a specific value;
marks={"Alice":90,"Bob":85,"Charlie":90}
target=90
result=[]
for key, value in marks.items():
    if value == target:
        result.append(value)
        print(f"{key}:{value}")
print(result)


Count character frequency in a string using a dictionary;
text = input("Enter the string: ")
freq = {}

for char in text:
    if char not in freq:
        freq[char] = 1
    else:
        freq[char] += 1

print(freq)
